<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="hospital">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="patient" maxOccurs="unbounded">
                    <xs:complexType>

                        <xs:sequence>
                            <xs:element name="name" type="xs:string"/>
                            
                            <xs:element name="gender">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="Male"/>
                                        <xs:enumeration value="Female"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <xs:element name="dob" type="xs:date"/>

                            <xs:element name="phone">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:pattern value="\d{10}"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <xs:element name="records">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="record" minOccurs="1" maxOccurs="unbounded">
                                            <xs:complexType>

                                                <xs:sequence>
                                                    <xs:element name="visitDate" type="xs:date"/>
                                                    <xs:element name="doctor" type="xs:string"/>
                                                    <xs:element name="diagnosis" type="xs:string"/>
                                                    <xs:element name="treatment" type="xs:string"/>

                                                    <xs:element name="prescriptions">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="medicine" type="xs:string" maxOccurs="unbounded"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>

                                                    <xs:element name="billing">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="consultationFee" type="xs:decimal"/>
                                                                <xs:element name="medicationCost" type="xs:decimal"/>
                                                                <xs:element name="totalCost" type="xs:decimal"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>

                                                </xs:sequence>

                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                        </xs:sequence>

                        <!-- Unique Patient ID -->
                        <xs:attribute name="id" type="xs:integer" use="required"/>

                    </xs:complexType>
                </xs:element>
            </xs:sequence>

            <!-- Enforce unique patient IDs -->
            <xs:unique name="uniquePatientID">
                <xs:selector xpath="patient"/>
                <xs:field xpath="@id"/>
            </xs:unique>

        </xs:complexType>
    </xs:element>

</xs:schema>